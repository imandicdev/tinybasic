; Normalized IL listing (one instruction per line)
; Source: user-provided IL listing from PCC Tiny BASIC (pages 15-18)

START: INIT
ERRENT: NLINE
CO: GETLN
TSTL XEC
INSRT
IJMP CO

XEC: XINIT

STMT: TST S1,'LET'
SE1: TSTV SE1
SE2: TST SE2,'='
ICALL EXPR
DONE
STORE
NXT

S1: TST S3,'GO'
TST S2,'TO'
ICALL EXPR
DONE
XFER
NXT

S2: TST S2,'SUB'
ICALL EXPR
DONE
SAV
XFER
NXT

S3: TST S8,'PRINT'
S4: TST S7,'"'
PRS
HOP S5
S7: ICALL EXPR
PRN
S5: TST S6,','
SPC
HOP S4
S6: DONE
NLINE
NXT

S8: TST S9,'IF'
ICALL EXPR
ICALL RELOP
ICALL EXPR
S8A: TST S8A,'THEN'
CMPR
IJMP STMT

S9: TST S12,'INPUT'
S10: TSTV S10
INNUM
STORE
TST S11,','
HOP S10
S11: DONE
NXT

S12: TST S13,'DATA'
DATA
NXT

S13: TST S14,'READ'
S13A: TSTV S13A
RDAT
STORE
TST S13B,','
HOP S13A
S13B: DONE
NXT

S14: TST S15,'RESTORE'
DONE
REST
NXT

S15: TST S16,'POKE'
ICALL EXPR
TST S15A,','
ICALL EXPR
DONE
POKE
NXT
S15A: ERR

S16: TST S17,'CALL'
ICALL EXPR
DONE
BCALL
NXT

S17: TST S18,'RETURN'
DONE
RSTR
NXT

S18: TST S19,'END'
FIN

S19: TST S20,'LIST'
DONE
LST
NXT

S20: TST S21,'RUN'
DONE
IJMP XEC

S21: TST S22,'CLS'
CLS
NXT

S22: TST S23,'CLEAR'
IJMP START

S23: TST S24,'SAVE'
SAVE
NXT

S24: TST S25,'LOAD'
LOAD
NXT

S25: TST S25,'BYE'
DONE
BYE

EXPR: TST E0,'-'
ICALL TERM
NEG
HOP E1
E0: TST E01,'+'
E01: ICALL TERM
E1: TST E2,'+'
ICALL TERM
ADD
HOP E01
E2: TST E3,'-'
ICALL TERM
SUB
HOP E1
E3: RTN

TERM: ICALL FACT
T0: TST T1,'*'
ICALL FACT
MPY
HOP T0
T1: TST T2,'/'
ICALL FACT
DIV
HOP T0
T2: RTN

FACT: TSTV F0
IND
RTN
F0: TSTN F1
RTN
F1: TST F2,'PEEK'
TST FPE1,'('
ICALL EXPR
TST FPE1,')'
PEEK
RTN
FPE1: ERR
RTN
F2: TST F3,'('
ICALL EXPR
FE1: TST FE1,')'
F3: RTN

RELOP: TST R0,'='
LIT 0
RTN
R0: TST R4,'<'
TST R1,'='
LIT 2
RTN
R1: TST R3,'>'
LIT 3
RTN
R3: LIT 1
RTN
R4: TST R4,'>'
TST R5,'='
LIT 5
RTN
R5: TST R6,'<'
LIT 3
RTN
R6: LIT 4
RTN
